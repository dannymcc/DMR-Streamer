# --- Generate fresh passwords ---
#   openssl rand -hex 16  (one per variable below)
ICECAST_SOURCE_PASSWORD=changeme_source
ICECAST_ADMIN_PASSWORD=changeme_admin
ICECAST_RELAY_PASSWORD=changeme_relay

# Used to sign session cookies in the FastAPI app
#   openssl rand -hex 32
SECRET_KEY=changeme_secret_key

# Talkgroups the receiver subscribes to. Comma-separated.
BM_TGS=2350,2351,2352,2353,235,3100,23520,23526,23531,23562,235175
BM_DMR_ID=1234567
BM_PASSWORD=changeme_brandmeister_hotspot_security_password
BM_MASTER=51.68.220.36
BM_PORT=54006

# Public mount path on the stream
ICECAST_MOUNT=/dmr.opus
ICECAST_PUBLIC_URL=http://localhost:8000
ICECAST_HOSTNAME=localhost
ICECAST_ADMIN_EMAIL=admin@example.invalid
ICECAST_LOCATION=Unspecified
STREAM_DESCRIPTION=BrandMeister DMR talkgroups
APP_CALLSIGN=DMR
APP_DESCRIPTION=Live DMR audio stream and talkgroup activity.

# Optional: BrandMeister API key (Profile → Security → API Keys)
# Without this, last-heard uses the public unauthenticated endpoint
# which is rate-limited and occasionally flaky.
BRANDMEISTER_API_KEY=

TZ=UTC
